    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// n8n Code node \"Check speech\" (mode: Run Once for Each Item).\n// Input: Groq Whisper's verbose_json. Output: the fields \"Save transcript\" writes.\n// On music-only Reels Whisper still \"hears\" a few words, so a short result, or one\n// Whisper itself thinks is probably not speech, counts as a No-speech Reel.\n\nconst MIN_WORDS = 15;          // fewer than this is not enough to summarise\nconst MAX_NO_SPEECH = 0.5;     // Whisper's own \"this is probably not speech\" score, 0 to 1\n\nconst text = ($json.text ?? '').trim();\nconst segments = $json.segments ?? [];\n\nconst words = text.split(/\\s+/).filter(Boolean).length;\nconst noSpeech = segments.length\n  ? segments.reduce((sum, s) => sum + (s.no_speech_prob ?? 0), 0) / segments.length\n  : 1;\nconst hasSpeech = words >= MIN_WORDS && noSpeech < MAX_NO_SPEECH;\n\nconst media = $('Pick media').item.json;\nreturn {\n  json: {\n    id: media.id,\n    url: media.realUrl,\n    caption: media.caption,\n    has_speech: hasSpeech,\n    transcript: hasSpeech ? text : '',\n  },\n};\n"
      },
      "id": "dd3ff5a8-3014-4c74-a98e-cd78ff7ff20f",
      "name": "Check speech",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        -160
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// n8n Code node \"YouTube transcript\" (mode: Run Once for Each Item).\n// Input: the full response of the starvibe/youtube-video-transcript Apify actor, which\n// reads YouTube's own captions (no download, no Whisper); its result is in `body`.\n// Output: the same fields as \"Check speech\", so it goes straight into \"Save transcript\".\n\nconst MIN_WORDS = 15; // same bar as \"Check speech\"\n\nconst reel = $('Loop over reels').item.json;\nconst r = $json.body?.[0];\n\n// No title means YouTube didn't return the video at all (removed, private, bad link)\nif (!r || !r.title) {\n  throw new Error(`YouTube: ${r?.message || 'video not found (removed or private?)'}`);\n}\n\n// No captions on a Short usually means music only, so it's a No-speech Reel, not a failure\nconst text = (r.transcript_text ?? '').trim();\nconst hasSpeech = r.status === 'success' && text.split(/\\s+/).filter(Boolean).length >= MIN_WORDS;\n\n// Shorts have no separate caption, so title + description play that part\nconst caption = [r.title, r.description].filter(Boolean).join('\\n\\n').slice(0, 2000);\n\nreturn {\n  json: {\n    id: reel.id,\n    url: reel.url,\n    caption,\n    has_speech: hasSpeech,\n    transcript: hasSpeech ? text : '',\n  },\n};\n"
      },
      "id": "e24fb0d9-18a2-464d-a077-872dd46c9b08",
      "name": "YouTube transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        0
      ],
      "onError": "continueErrorOutput"
    },
