      "id": "376ed317-8a76-4efd-b4fc-1e879673d710",
      "name": "Whisper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1424,
        -272
      ],
      "credentials": {
